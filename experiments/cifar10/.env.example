TRAINER_MODULE=experiments.cifar10.trainer
# Optional: override the topology-specific run ID from the selected Compose.
# RUN_ID=my-run
ROUNDS=10
LOCAL_EPOCHS=1
BATCH_SIZE=64
LEARNING_RATE=0.01
MOMENTUM=0.9
# Use iid for uniform random splitting or dirichlet for non-IID label proportions.
# Leave unset to use the selected Compose partition mode.
# PARTITION_MODE=dirichlet
# Smaller alpha produces more concentrated class distributions per client.
DIRICHLET_ALPHA=0.5
MIN_PARTITION_SIZE=100
SEED=42
REQUEST_TIMEOUT=5
REQUEST_RETRIES=3
RETRY_DELAY=1
HEAD_START_DELAY=5
TORCH_NUM_THREADS=1
# Set these to small values for a quick smoke test; 0 uses the full dataset.
MAX_TRAIN_SAMPLES=0
MAX_TEST_SAMPLES=0
