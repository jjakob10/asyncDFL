# Host directory containing ECG/preprocessed. This default matches an adjacent
# FedCVD checkout; use an absolute path when the dataset lives elsewhere.
ECG_DATA_DIR=../../../FedCVD/data

TRAINER_MODULE=experiments.ecg.trainer
ROUNDS=50
LOCAL_EPOCHS=1
BATCH_SIZE=32
LEARNING_RATE=0.1
MOMENTUM=0
PARTITION_MODE=iid
DIRICHLET_ALPHA=0.5
SEED=42
REQUEST_TIMEOUT=5
REQUEST_RETRIES=3
RETRY_DELAY=1
HEAD_START_DELAY=5
TORCH_NUM_THREADS=1

# Set these to small values for a quick smoke test; 0 uses the full dataset.
MAX_TRAIN_SAMPLES=0
MAX_TEST_SAMPLES=0
