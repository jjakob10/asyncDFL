TRAINER_MODULE=experiments.cifar10.trainer
ROUNDS=10
LOCAL_EPOCHS=1
BATCH_SIZE=64
LEARNING_RATE=0.01
MOMENTUM=0.9
PARTITION_MODE=iid
DIRICHLET_ALPHA=0.5
SEED=42
REQUEST_TIMEOUT=5
REQUEST_RETRIES=3
RETRY_DELAY=1
HEAD_START_DELAY=5
TORCH_NUM_THREADS=1
# Set these to small values for a quick smoke test; 0 uses the full dataset.
MAX_TRAIN_SAMPLES=0
MAX_TEST_SAMPLES=0
